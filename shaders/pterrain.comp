#version 450
#include "perlin.glsl"

// Define the 3D texture we will write to
layout(binding = 0, rgba8) uniform readonly image3D inputTexture;
layout(binding = 1, rgba8) uniform writeonly image3D terrainTexture;
layout(binding = 2, rgba32f) uniform writeonly image3D normalTexture;

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(push_constant) uniform Push {
    int octaves;
    float persistence;
    float scale;
    float height_limit;
    ivec3 worldOffset;     // Input position offset (x, y, z)
} push;

// Perlin noise function (simple implementation)
float fractalNoise(vec3 pos, int octaves, float persistence) {
    float sum = 0.0;
    float frequency = 1.0;
    float amplitude = 1.0;
    float max = 0.0;
    
    for (int i = 0; i < octaves; i++) {
        sum += perlinNoise(pos * frequency) * amplitude;
        max += amplitude;
        amplitude *= persistence;
        frequency *= 2.0;
    }
    
    // Normalize to [0,1]
    return (sum / max + 1.0) * 0.5;
}

uint packR11G11B10UF(float r, float g, float b) {
    uint ur = uint(clamp(r * 2047.0, 0.0, 2047.0)); // Pack R (11 bits)
    uint ug = uint(clamp(g * 2047.0, 0.0, 2047.0)); // Pack G (11 bits)
    uint ub = uint(clamp(b * 1023.0, 0.0, 1023.0)); // Pack B (10 bits)

    return (ur << 0) | (ug << 11) | (ub << 22); // Combine into a 32-bit uint
}


vec3 computeNormal(vec3 pos) {
    // Sample positions slightly offset to calculate gradients
    float dx = fractalNoise(pos + vec3(0.01, 0.0, 0.0), push.octaves, push.persistence)
             - fractalNoise(pos, push.octaves, push.persistence);
    float dy = fractalNoise(pos + vec3(0.0, 0.01, 0.0), push.octaves, push.persistence)
             - fractalNoise(pos, push.octaves, push.persistence);
    float dz = fractalNoise(pos + vec3(0.0, 0.0, 0.01), push.octaves, push.persistence)
             - fractalNoise(pos, push.octaves, push.persistence);

    return normalize(vec3(dx, dy, dz));
}

void main() {
    ivec3 voxelCoord = ivec3(gl_GlobalInvocationID.xyz);
    ivec3 Size = imageSize(inputTexture); // Get the texture size

    // Skip out-of-bounds threads
    if (any(greaterThanEqual(voxelCoord, Size))) {
        return;
    }

    ivec3 input_voxelCoord = voxelCoord;

    // Check if inversion along axes is needed
    bool invertX = int(push.worldOffset.x) % 2 == 1;
    bool invertY = int(push.worldOffset.y) % 2 == 1;
    bool invertZ = int(push.worldOffset.z) % 2 == 1;

    // Adjust coordinates based on inversion
    if (invertX) {
        input_voxelCoord.x = Size.x - 1 - voxelCoord.x;
    }
    if (invertY) {
        input_voxelCoord.y = Size.y - 1 - voxelCoord.y;
    }
    if (invertZ) {
        input_voxelCoord.z = Size.z - 1 - voxelCoord.z;
    }

    vec3 normalizedPos = vec3(voxelCoord) / vec3(Size); // Normalize to [0, 1] range
    vec3 worldPos = normalizedPos * push.scale + push.worldOffset;

    float baseRotationAngle = 0.5236; // Example rotation angle in radians (~30 degrees)

    // Multi-octave noise generation
    float noiseScale = 0.25; // Base scale for noise
    float amplitude = 0.5;  // Base amplitude
    float frequency = 1.0;  // Base frequency
    float finalNoise = imageLoad(inputTexture, input_voxelCoord).r; // Accumulated noise
    int octaves = 3;        // Number of octaves
    float lacunarity = 1.9; // Frequency multiplier (slightly less than 2)
    float gain = 0.5;       // Amplitude multiplier

    for (int i = 0; i < octaves; ++i) {
        float dynamicAngle = baseRotationAngle * float(i + 1); // Vary angle by octave
        mat3 dynamicRotationMatrix = mat3(
            vec3(cos(dynamicAngle), -sin(dynamicAngle), 0.0),
            vec3(sin(dynamicAngle),  cos(dynamicAngle), 0.0),
            vec3(0.0,                0.0,                1.0)
        );

        // Apply rotation to the scaled position
        vec3 rotatedPos = dynamicRotationMatrix * (worldPos * frequency);

        // Adjust rotatedPos based on inversion
        if (invertX) {
            rotatedPos.x = 1.0 - rotatedPos.x; // Invert along X-axis
        }
        if (invertY) {
            rotatedPos.y = 1.0 - rotatedPos.y; // Invert along Y-axis
        }
        if (invertZ) {
            rotatedPos.z = 1.0 - rotatedPos.z; // Invert along Z-axis
        }

        // Convert rotatedPos to voxel coordinates for noise sampling
        vec3 wrappedPos = mod(rotatedPos, 1.0); // Wrap within [0, 1] range
        ivec3 rotatedVoxelCoord = ivec3(wrappedPos * vec3(Size));

        // Sample noise using rotated coordinates
        float noiseValue = imageLoad(inputTexture, rotatedVoxelCoord).r;

        // Accumulate noise
        // finalNoise += noiseValue * amplitude;

        // Update frequency and amplitude for the next octave
        frequency *= lacunarity; // Increase frequency
        amplitude *= gain;       // Decrease amplitude
    }

    // float noiseValue = imageLoad(inputTexture, input_voxelCoord).r; // Red channel

    // // Scale and offset noise for intensity control
    // float noiseScale = 0.27; // Scale the noise effect
    float noisySpot = finalNoise * noiseScale;

    vec3 ballCenter = vec3(3, 3, 1.5);
    float ballRadius = 2;
    float distanceToCenter = length(worldPos - ballCenter);

    // Add noise to base terrain
    float baseValue = worldPos.z / push.height_limit;
    float finalValue = clamp(1.0 - (distanceToCenter / ballRadius), 0.0, 1.0); //= baseValue - noisySpot;
    finalValue = clamp (finalValue, 0, 1);

    // Write final value to a texture
    imageStore(terrainTexture, voxelCoord, vec4(finalValue, 0.0, 0.0, 1.0));

    // Compute gradient to generate normals
    float dx = imageLoad(inputTexture, voxelCoord + ivec3(1, 0, 0)).r - 
               imageLoad(inputTexture, voxelCoord - ivec3(1, 0, 0)).r;
    float dy = imageLoad(inputTexture, voxelCoord + ivec3(0, 1, 0)).r - 
               imageLoad(inputTexture, voxelCoord - ivec3(0, 1, 0)).r;
    float dz = imageLoad(inputTexture, voxelCoord + ivec3(0, 0, 1)).r - 
               imageLoad(inputTexture, voxelCoord - ivec3(0, 0, 1)).r;

    vec3 gradient = vec3(dx, dy, dz);
    vec3 normal = normalize(gradient); // Normalize gradient to get the normal

    // Store normal in normalTexture
    vec3 packedNormal = normal * 0.5 + 0.5; // Pack to [0, 1] range for storage
    imageStore(normalTexture, voxelCoord, vec4(packedNormal, 1.0));
}

void main_old() {
    ivec3 texCoord = ivec3(gl_GlobalInvocationID.xyz);
    ivec3 Size = imageSize(terrainTexture); // Get the texture size
    // Skip out-of-bounds threads
    if (any(greaterThanEqual(texCoord, Size))) {
        return; // Exit the shader for out-of-bounds threads
    }
    
    vec3 normalizedPos = vec3(texCoord) / vec3(imageSize(terrainTexture));
    // Scale and shift to match the input position offset
    vec3 worldPos = normalizedPos * push.scale + push.worldOffset;
    
    // Scale to control noise frequency
    int octaves = push.octaves;         // Number of noise layers
    float persistence = push.persistence; // Controls amplitude scaling between layers
    float noiseScale = push.scale;
    
    // Compute terrain density value
    float noiseValue = fractalNoise(worldPos, octaves, persistence);

    vec3 normal = vec3(0.0);
    uint packedNormal = 0;

    if(noiseValue > 0.3333 && noiseValue < 0.6667){
        // Compute normal vector
        // normal = computeNormal(worldPos);
        normal = vec3 (0,1,0);
        //packedNormal = packR11G11B10UF(normal.r, normal.g, normal.b);
    }

    // Write normal to normalTexture (packed format)
    // imageStore(normalTexture, texCoord, uvec4(packedNormal, 0, 0, 0)); // Pack as float RGB
    imageStore(normalTexture, texCoord, vec4(normal, 1.0));

    float base = worldPos.z / push.height_limit;

    float frequency = 1.5; // Number of oscillations
    float amplitude = 0.2;  // Height of the wave (from 0 to 1)

    // Sine wave based on x-coordinate
    float sineWave = amplitude * sin(2.0 * 3.14159265 * frequency * (worldPos.x));

    vec2 target = vec2(0.5, 0.5); // Target position
    float radius = 0.2;
    float test_noise = 0.;
    if (distance(normalizedPos.xy, target) < radius) {
        test_noise = 0.5 * distance(normalizedPos.xy, target);
    }

    noiseValue = sin(base) + 0.5 * noiseValue;
    noiseValue = clamp(noiseValue, 0.0, 1.0);

    // Convert to 8-bit grayscale and write to texture
    vec4 color = vec4(vec3(noiseValue), 1.0);
    
    imageStore(terrainTexture, texCoord, color);

}
