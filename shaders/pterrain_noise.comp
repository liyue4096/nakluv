#version 450
#include "perlin.glsl"

// Define the 3D texture we will write to
layout(binding = 0, rgba8) uniform writeonly image3D noiseTexture;
layout(binding = 1, rgba32f) uniform writeonly image3D normalTexture;

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

// noise function (simple implementation)
float random(vec3 p) {
    return fract(sin(dot(p, vec3(12.9898, 78.233, 54.53))) * 43758.5453);
}

// Perlin noise function (simple implementation)
float fractalNoise(vec3 pos, int octaves, float persistence) {
    float sum = 0.0;
    float frequency = 1.0;
    float amplitude = 1.0;
    float max = 0.0;
    
    for (int i = 0; i < octaves; i++) {
        sum += perlinNoise(pos * frequency) * amplitude;
        max += amplitude;
        amplitude *= persistence;
        frequency *= 2.0;
    }
    
    // Normalize to [0,1]
    return (sum / max + 1.0) * 0.5;
}

// Function to generate seamless random noise for 3D texture
float seamlessRandomNoise(vec3 p) {
    // Use modulo to wrap coordinates
    vec3 wrappedCoord = fract(p);

    // Generate random value based on the wrapped coordinates
    return random(wrappedCoord);
}

float seamlessNoise(vec3 p, float wrap) {
    // Wrap the coordinates into the [0, wrap] range
    vec3 wrappedP = mod(p, wrap) / wrap;

    // Generate Perlin noise with wrapped coordinates
    return fractalNoise(wrappedP, 8, 0.5);
}

float testNoise(vec3 p, float wrap) {
    
    vec2 target = vec2(0.5, 0.5); // Target position
    float radius = 0.25;
    float test_noise = 0.;
    if (distance(p.xy, target) < radius) {
        test_noise = 1 - 3 * distance(p.xy, target);
    }
    return test_noise;
}

void main() {
    // Get the global thread ID
    ivec3 texCoord = ivec3(gl_GlobalInvocationID.xyz);

    // Get the size of the noise texture (for 3D texture)
    ivec3 size = imageSize(noiseTexture);

    // Ensure we are within bounds of the texture (optional, but good practice)
    if (any(greaterThanEqual(texCoord, size))) {
        return;
    }

    // Normalize the texel position to [0,1]
    vec3 normalizedPos = vec3(texCoord) / vec3(size);

    // Generate random noise based on normalized position
    float noiseValue = seamlessNoise(normalizedPos, 1);

    // Pack the noise value into a vec4 (RGBA) and write it to the noiseTexture
    imageStore(noiseTexture, texCoord, vec4(noiseValue, noiseValue, noiseValue, 1.0));

    // Optionally, generate normal or other data for normalTexture
    // Example: create a simple normal based on the random noise
    vec3 normal = normalize(vec3(noiseValue * 2.0 - 1.0, noiseValue * 2.0 - 1.0, 1.0));
    imageStore(normalTexture, texCoord, vec4(normal, 1.0));
}
